
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chat_rooms/$(roomId))
        && request.auth.uid in get(
          /databases/$(database)/documents/chat_rooms/$(roomId)
        ).data.users;
    }

    function hasValidLastMessage(roomId) {
      let room = request.resource.data;
      let messagePath = /databases/$(database)/documents/chat_rooms/$(roomId)/messages/$(room.lastMessageId);
      let msg = getAfter(messagePath);

      return !exists(messagePath)
        && msg != null
        && msg.data.message == room.lastMessage
        && msg.data.senderId == request.auth.uid
        && msg.data.senderEmail == request.auth.token.email
        && msg.data.receiverId in room.users
        && msg.data.receiverId != request.auth.uid
        && msg.data.timestamp == request.time;
    }

    function validMessageForRoom(roomId, messageId) {
      let room = getAfter(
        /databases/$(database)/documents/chat_rooms/$(roomId)
      );

      return room != null
        && room.data.users is list
        && request.auth.uid in room.data.users
        && request.resource.data.receiverId in room.data.users
        && request.resource.data.receiverId != request.auth.uid
        && room.data.lastMessageId == messageId
        && room.data.lastMessage == request.resource.data.message
        && room.data.lastTimestamp == request.time;
    }

    // POSTS
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // MEETUP REQUESTS
    match /meetup_requests/{meetupId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId
        );

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUserId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']);

      allow delete: if false;
    }

    // CHAT ROOMS
    match /chat_rooms/{roomId} {
      allow get: if isSignedIn()
        && (
          resource == null
          || request.auth.uid in resource.data.users
        );

      allow list: if isSignedIn()
        && request.auth.uid in resource.data.users;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'users', 'userEmails', 'itemTitle',
          'lastMessage', 'lastMessageId', 'lastTimestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'users', 'userEmails', 'itemTitle',
          'lastMessage', 'lastMessageId', 'lastTimestamp'
        ])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] is string
        && request.resource.data.users[1] is string
        && request.resource.data.users[0] != request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && (
          roomId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
          || roomId == request.resource.data.users[1] + '_' + request.resource.data.users[0]
        )
        && request.resource.data.userEmails is map
        && request.resource.data.userEmails.keys()
          .hasAll(request.resource.data.users)
        && request.resource.data.userEmails.keys()
          .hasOnly(request.resource.data.users)
        && request.resource.data.userEmails[request.auth.uid]
          == request.auth.token.email
        && request.resource.data.itemTitle is string
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageId.size() > 0
        && hasValidLastMessage(roomId)
        && request.resource.data.lastTimestamp == request.time;

      allow update: if isSignedIn()
        && resource.data.users is list
        && request.auth.uid in resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'lastMessage', 'lastMessageId', 'lastTimestamp'
          ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageId.size() > 0
        && hasValidLastMessage(roomId)
        && request.resource.data.lastTimestamp == request.time;

      allow delete: if false;

      // MESSAGES
      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);

        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll([
            'message', 'senderId', 'receiverId',
            'senderEmail', 'timestamp'
          ])
          && request.resource.data.keys().hasOnly([
            'message', 'senderId', 'receiverId',
            'senderEmail', 'timestamp'
          ])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && validMessageForRoom(roomId, messageId)
          && request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }
  }
}

